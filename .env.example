# ─────────────────────────────────────────────────────────────────────────────
# Resin Pros Ops Dashboard — environment variables
#
# Copy to `.env.local` and fill in. With NONE of these set, the app runs entirely
# on fixture data (`npm run dev` works out of the box). Each block is optional and
# unlocks a real integration once configured. See README.md for setup order.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (persistence + auth) ────────────────────────────────────────────
# Without these the data layer falls back to fixtures and auth is bypassed in dev.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by webhook + cron routes to write synced data past RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ── Jobber OAuth2 + API (CRM system of record) ───────────────────────────────
# Create an app at https://developer.getjobber.com/ . Redirect URI must match
# `${APP_URL}/api/jobber/callback`.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# Shared secret Jobber signs webhook payloads with (HMAC-SHA256).
JOBBER_WEBHOOK_SECRET=
# Jobber GraphQL API version date (see Jobber changelog). Sent as X-JOBBER-GRAPHQL-VERSION.
JOBBER_API_VERSION=2025-04-16

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of this deployment; used to build OAuth redirect + magic links.
APP_URL=http://localhost:3000
# Secret guarding the cron reconciliation endpoint (Vercel Cron sends it as a bearer token).
CRON_SECRET=
